# Segredos do docker-compose (copiar para .env e preencher; o .env não entra no Git).
# Gerar valores aleatórios, por exemplo:
#   openssl rand -base64 32      (POSTGRES_PASSWORD, DATA_PROTECTION_MASTER_KEY)
#   openssl rand -base64 48      (JWT_SIGNING_KEY)

# Palavra-passe do PostgreSQL.
POSTGRES_PASSWORD=

# Chave HMAC dos tokens de acesso (32+ caracteres). Nunca a de appsettings.Development.json.
JWT_SIGNING_KEY=

# Chave-mestra que cifra as chaves do Data Protection guardadas na base (base64 de exatamente 32 bytes).
# Guarda-a fora das cópias de segurança da base: sem ela, os segredos das contas ligadas e da 2FA não se leem.
DATA_PROTECTION_MASTER_KEY=

# Endereço público da API (para os regressos do OAuth e os endereços de calendário) e da app web.
PUBLIC_BASE_URL=http://localhost:5281
APP_ORIGIN=http://localhost:8080

# true num servidor com HTTPS (HSTS e redirecionamento); false neste ambiente local sem certificado.
HTTPS_ENFORCE=false

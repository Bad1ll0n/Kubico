{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Kubico": "Host=localhost;Port=5432;Database=kubico;Username=kubico;Password=kubico"
  },
  "Database": {
    "Provider": "Postgres",
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "kubico",
    "Audience": "kubico-apps",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "LoginPerMinute": 10,
    "RegisterPerMinute": 5,
    "RefreshPerMinute": 30,
    "ChildLoginPerMinute": 10,
    "ChildProfilesPerMinute": 30
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Https": {
    "Enforce": true
  },
  "CalendarSync": {
    "IntervalMinutes": 5,
    "Google": { "ClientId": "", "ClientSecret": "" },
    "Microsoft": { "ClientId": "", "ClientSecret": "", "Tenant": "common" }
  }
}

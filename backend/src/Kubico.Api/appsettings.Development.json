{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-in-production-0123456789"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:*", "http://127.0.0.1:*" ]
  },
  "RateLimiting": {
    "LoginPerMinute": 120,
    "RegisterPerMinute": 60,
    "RefreshPerMinute": 240,
    "ChildLoginPerMinute": 120,
    "ChildProfilesPerMinute": 120
  }
}
